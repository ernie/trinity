// TAB BUTTONS	//

itemDef {
	name tab_comfort
	group grpTabButtons
	text "Comfort"
	type 1
	textscale .2
	style WINDOW_STYLE_FILLED
	background "ui/assets/button_back.tga"
	rect 26 26 62 20
	textalign 1
	textalignx 31
	textaligny 15
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1
	visible 1
	action { hide grpVR ; show comfort }
	mouseEnter { setitemcolor tab_comfort backcolor .1 .37 .1 1 }
	mouseExit { setitemcolor tab_comfort backcolor .37 .1 .1 1 }
	}
itemDef {
	name tab_controls
	group grpTabButtons
	text "Controls"
	type 1
	textscale .2
	style WINDOW_STYLE_FILLED
	background "ui/assets/button_back.tga"
	rect 97 26 62 20
	textalign 1
	textalignx 31
	textaligny 15
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1
	visible 1
	action { hide grpVR ; show controls }
	mouseEnter { setitemcolor tab_controls backcolor .1 .37 .1 1 }
	mouseExit { setitemcolor tab_controls backcolor .37 .1 .1 1 }
	}
itemDef {
