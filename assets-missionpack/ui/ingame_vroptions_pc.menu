{
\\ IN-GAME VR OPTIONS (PC) - tabbed Team Arena style \\

menuDef {
	name "ingame_vroptions"
	visible 0
	fullscreen 0
	outOfBoundsClick			// this closes the window if it gets a click out of the rectangle
	rect 225 30 386 375
	focusColor 1 .75 0 1
	style 1
	border 1
	onOpen { hide grpVR ; show comfort ; uiScript vrMirrorSetup }

itemDef {
	name window
	rect 10 15 376 360
	style 1
	backcolor 0 .1 0 1
	visible 1
	decoration
	}

