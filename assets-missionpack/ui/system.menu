      		textalignx 128
      		textaligny 20
		textscale .333        
      		forecolor 1 1 1 1
      		visible 0 
		cvarTest "ui_vrActive"
		hideCvar { 1 }
		action { uiScript glCustom }
	}

	itemDef {
   		name graphics
