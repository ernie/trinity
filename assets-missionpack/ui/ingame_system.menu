itemDef {
	name ctr_graphics
	text "Graphics"
	type 1
	textscale .25
	group grpControlbutton
	style WINDOW_STYLE_FILLED
	background "ui/assets/button_back.tga"
	rect 18 25 58 20
	textalign 1
	textalignx 29
	textaligny 16
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1 
	visible 1
	action { hide grpSystem ; show graphics }
	mouseEnter { setitemcolor ctr_graphics backcolor .1 .37 .1 1 }
      	mouseExit { setitemcolor ctr_graphics backcolor .37 .1 .1 1 }
	}

	itemDef {
      		name graphics				
		group grpSystem
      	type ITEM_TYPE_MULTI
			text "Quality:"
		cvar "ui_glCustom"
		cvarFloatList { "High Quality" 0 "Normal" 1 "Fast" 2 "Fastest" 3 "Custom" 4 }
		rect 0 76 256 20
      		textalign ITEM_ALIGN_RIGHT
      		textalignx 133
      		textaligny 17
		textscale .25         
      		forecolor 1 1 1 1
      		visible 0 
			action { uiScript update "ui_glCustom" }
    		}

	itemDef {
		name graphics
		group grpSystem
		type ITEM_TYPE_MULTI
		text "MSAA:"
		cvar "r_ext_multisample"
		cvarFloatList { "Off" 0 "2x" 2 "4x" 4 "8x" 8 }
		rect 0 95 256 20
		textalign ITEM_ALIGN_RIGHT
		textalignx 133
		textaligny 17
		textscale .25
		forecolor 1 1 1 1
		visible 0
		cvarTest "r_fbo"
		disableCvar { "0" }
	}

	itemDef {
      		name graphics
		group grpSystem
     		type ITEM_TYPE_MULTI
		text "Lighting:"
		cvar "r_vertexlight"
		cvarFloatList { "Light Map (high)" 0 "Vertex (low)" 1  }
		rect 0 114 256 20
      		textalign ITEM_ALIGN_RIGHT
      		textalignx 133
      		textaligny 17
		textscale .25        
      		forecolor 1 1 1 1
      		visible 0 
			action { uiScript glCustom }
    		}

	itemDef {
		name graphics
		group grpSystem
		type ITEM_TYPE_MULTI
		text "Shadows:"
		cvar "cg_shadows"
		cvarFloatList { "None" 0 "Low" 1 "High" 2 }
		rect 0 133 256 20
		textalign ITEM_ALIGN_RIGHT
		textalignx 133
		textaligny 17
		textscale .25
		forecolor 1 1 1 1
		visible 0
	}

	itemDef {
      		name graphics
		group grpSystem
      		type ITEM_TYPE_MULTI
		text "Model Detail:"
		cvar "r_lodbias"
		cvarFloatList { "Very Low" 2 "Low" 1 "Medium" 0 "High" -1 "Very High" -2 }
		rect 0 152 256 20
      		textalign ITEM_ALIGN_RIGHT
      		textalignx 133
      		textaligny 17
		textscale .25
      		forecolor 1 1 1 1
      		visible 0
			action { uiScript glCustom }
    		}

	itemDef {
      		name graphics
		group grpSystem
      		type ITEM_TYPE_MULTI
		text "Curve Detail:"
		cvar "r_subdivisions"
		cvarFloatList { "Very Low" 20 "Low" 12 "Medium" 4 "High" 2 "Very High" 1 }
		rect 0 171 256 20
      		textalign ITEM_ALIGN_RIGHT
      		textalignx 133
      		textaligny 17
		textscale .25
      		forecolor 1 1 1 1
      		visible 0
			action { uiScript glCustom }
    		}

	itemDef {
      		name graphics
		group grpSystem
      		type ITEM_TYPE_MULTI
		text "Texture Detail:"
		cvar "r_picmip"
		cvarFloatList { "Low" 2 "Normal" 1 "High" 0 }
		rect 0 190 256 20
      		textalign ITEM_ALIGN_RIGHT
      		textalignx 133
      		textaligny 17
		textscale .25        
      		forecolor 1 1 1 1
      		visible 0 
			action { uiScript glCustom }
    		}

	itemDef {
      		name graphics
		group grpSystem
      		type ITEM_TYPE_MULTI
		text "Texture Quality:"
		cvar "r_texturebits"
		cvarFloatList { "Default" 0 "16 bit" 16 "32 bit" 32 }
		rect 0 209 256 20
      		textalign ITEM_ALIGN_RIGHT
      		textalignx 133
      		textaligny 17
		textscale .25        
      		forecolor 1 1 1 1
      		visible 0 
    		}

	itemDef {
      		name graphics
		group grpSystem
      		type ITEM_TYPE_MULTI
		text "Texture Filter:"
		cvar "r_texturemode"
		cvarStrList { "Bilinear", "GL_LINEAR_MIPMAP_NEAREST", "Trilinear", "GL_LINEAR_MIPMAP_LINEAR"  }
		rect 0 228 256 20
      		textalign ITEM_ALIGN_RIGHT
      		textalignx 133
      		textaligny 17
		textscale .25        
      		forecolor 1 1 1 1
      		visible 0 
		action { uiScript glCustom }
    		}

	itemDef {
      		name graphics
		group grpSystem
      		type ITEM_TYPE_YESNO
		text "Compress Textures:"
		cvar "r_ext_compressed_textures"
		rect 0 247 256 20
      		textalign ITEM_ALIGN_RIGHT
      		textalignx 133
      		textaligny 17
		textscale .25        
      		forecolor 1 1 1 1
      		visible 0 
		action { uiScript glCustom }
    		}

