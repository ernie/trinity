menuDef {
    	name "ingame_system"
    	visible 0
    	fullscreen 0
		outOfBoundsClick			// this closes the window if it gets a click out of the rectangle
    	rect 298 30 276 345
    	focusColor 1 .75 0 1
    	disableColor .5 .5 .5 1
    	style 1
    	border 1
	onopen { uiScript vrModeSetup ; hide grpsystem ; show graphics ; uiScript updateHDRAvail ; uiScript refreshModes ; collapseHidden 52 340 }

itemDef {
	name window
	rect 10 15 256 330
	style 1
	backcolor 0 .1 0 1
	visible 1
	decoration
	}

