itemDef {
      	name other			
	group grpSystem
      	style 1
	text "Display"
	rect 0 45 128 20
      	textalign ITEM_ALIGN_CENTER
      	textalignx 128
      	textaligny 17
	textscale .25         
      	forecolor 1 1 1 1
      	visible 0 
	decoration
    	}
	
	itemDef {
		name other
		group grpSystem
		type ITEM_TYPE_MULTI
		text "Display Mode:"
		cvar "ui_vrEnabled"
		cvarFloatList { "Flatscreen" 0 "VR" 1 }
		rect 0 65 256 20
		textalign ITEM_ALIGN_RIGHT
		textalignx 128
		textaligny 17
		textscale .25
		forecolor 1 1 1 1
		visible 0
		cvarTest "ui_vrModeSwitchAvailable"
		showCvar { "1" }
		action { uiScript vrModeChanged }
	}

	itemDef {
