// Custom Resolution, shown in place of the Graphics rows like the in-game Leave confirmation
	itemDef {
		name customres
		group grpSystem
		text "Custom Resolution"
		style 0
		textscale .3
		textstyle 3
		rect 0 70 276 20
		textalign ITEM_ALIGN_CENTER
		textalignx 138
		textaligny 15
		forecolor 1 1 1 1
		visible 0
		decoration
	}

	itemDef {
		name customres
		group grpSystem
		type ITEM_TYPE_MULTI
		cvar "ui_customRatio"
		cvarFloatList { "Free" 0 "16:9" 1 "16:10" 2 "21:9" 3 "32:9" 4 "4:3" 5 }
		action { uiScript customResFillWidth }
		text "Aspect:"
		rect 0 100 256 17
		textalign ITEM_ALIGN_RIGHT
		textalignx 133
		textaligny 17
		textscale .25
		forecolor 1 1 1 1
		visible 0
	}

	itemDef {
		name customres
		group grpSystem
		type ITEM_TYPE_NUMERICFIELD
		cvar "ui_customW"
		maxchars 5
		onEditEnd { uiScript customResFillWidth }
		text "Width:"
		rect 0 117 256 17
		textalign ITEM_ALIGN_RIGHT
		textalignx 133
		textaligny 17
		textscale .25
		forecolor 1 1 1 1
		visible 0
	}

	itemDef {
		name customres
		group grpSystem
		type ITEM_TYPE_NUMERICFIELD
		cvar "ui_customH"
