itemDef {
	name ctr_graphics
	text "Graphics"
	type 1
	textscale .25
	group grpControlbutton
	style WINDOW_STYLE_FILLED
	background "ui/assets/button_back.tga"
	rect 18 25 58 20
	textalign 1
	textalignx 29
	textaligny 16
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1 
	visible 1
	action { hide grpSystem ; show graphics ; collapseHidden 52 340 }
	mouseEnter { setitemcolor ctr_graphics backcolor .1 .37 .1 1 }
      	mouseExit { setitemcolor ctr_graphics backcolor .37 .1 .1 1 }
	}

	itemDef {
      		name graphics				
		group grpSystem
      	type ITEM_TYPE_MULTI
			text "Quality:"
		cvar "ui_glCustom"
		cvarFloatList { "High Quality" 0 "Normal" 1 "Fast" 2 "Fastest" 3 "Custom" 4 }
		rect 0 52 256 17
      		textalign ITEM_ALIGN_RIGHT
      		textalignx 133
      		textaligny 17
		textscale .25         
      		forecolor 1 1 1 1
      		visible 0 
			action { uiScript update "ui_glCustom" }
    		}

	itemDef {
		name graphics
		group grpSystem
		type ITEM_TYPE_MULTI
		text "MSAA:"
		cvar "r_ext_multisample"
		cvarFloatList { "Off" 0 "2x" 2 "4x" 4 "8x" 8 }
		rect 0 69 256 17
		textalign ITEM_ALIGN_RIGHT
		textalignx 133
		textaligny 17
		textscale .25
		forecolor 1 1 1 1
		visible 0
		cvarTest "r_fbo"
		disableCvar { "0" }
	}

	itemDef {
      		name graphics
		group grpSystem
     		type ITEM_TYPE_MULTI
		text "Lighting:"
		cvar "r_vertexlight"
