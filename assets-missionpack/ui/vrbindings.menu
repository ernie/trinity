itemDef {
	name back
	style 3
	background "ui/assets/backarrow.tga"
	rect 16 424 50 50
	visible 1
	action { close vrbindings_menu ; open vroptions_menu }
	mouseEnter { hide back ; show back_alt ; show message_back }
	}

itemDef {
	name back_alt
	style WINDOW_STYLE_SHADER
	background "ui/assets/backarrow_alt.tga"
	rect 14 422 54 54
	backcolor 0 0 0 0
	forecolor 1 1 1 1
	visible 0
	type ITEM_TYPE_BUTTON
	action { close vrbindings_menu ; open vroptions_menu }
	mouseExit { hide back_alt ; show back ; hide message_back }
	}

itemDef {
	name message_back
	group grpmessage
	style 0
	rect 320 430 128 30
	textstyle 1
	textalign 1
	textalignx 0
	textaligny 25
	textscale .4
	text "Back to VR Options"
	forecolor 1 1 1 1
	decoration
	visible 0
	}

}

// RESET CONFIRM: a popup, so it owns the pointer and the rows beneath can't take clicks //

menuDef {
	name "vrbindings_confirm"
	visible 0
	fullscreen 0
	// 242 wide: the longest line is under 193.5 at scale .3 (fontImage_16 xSkip sum x .3 x glyphScale 3), with 24 or more each side
	rect 199 158 242 144
	focusColor 1 .75 0 1
	style WINDOW_STYLE_FILLED
	border 1
	bordercolor .5 .5 .5 1
	backcolor 0 0 0 .9
	popup
	onESC { close vrbindings_confirm ; open vrbindings_menu }

itemDef {
	name confirm_title
	text "RESET BINDINGS?"
	rect 0 14 242 20
	textalign ITEM_ALIGN_CENTER
	textalignx 121
	textaligny 16
	textscale .35
	forecolor 1 1 1 1
	visible 1
	decoration
	}

itemDef {
	name confirm_text
	text "All VR buttons will get"
	rect 0 42 242 20
	textalign ITEM_ALIGN_CENTER
	textalignx 121
	textaligny 16
	textscale .3
	forecolor 1 1 1 1
	visible 1
	decoration
	}

itemDef {
	name confirm_text2
	text "this controller's defaults."
	rect 0 64 242 20
	textalign ITEM_ALIGN_CENTER
	textalignx 121
	textaligny 16
	textscale .3
	forecolor 1 1 1 1
	visible 1
	decoration
	}

itemDef {
	name confirm_yes
	text "Yes"
	type 1
	rect 21 100 80 30
	textalign ITEM_ALIGN_CENTER
	textalignx 40
	textaligny 22
	textscale .35
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; exec "vr_bindreset" ; close vrbindings_confirm ; open vrbindings_menu }
	}

itemDef {
	name confirm_no
	text "No"
	type 1
	rect 141 100 80 30
	textalign ITEM_ALIGN_CENTER
	textalignx 40
	textaligny 22
	textscale .35
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; close vrbindings_confirm ; open vrbindings_menu }
	}

