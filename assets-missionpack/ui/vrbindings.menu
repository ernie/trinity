#include "ui/menudef.h"

{
\\ VR BINDINGS - per-tab VR controller actions, bound by pressing the button \\

menuDef {
	name "vrbindings_menu"
	visible 0
	fullscreen 1
	rect 0 0 640 480
	background "menuback_a"
	focusColor 1 .75 0 1
	disableColor .5 .5 .5 1
	style 1
	border 1
	// Resets only the back arrow's hover state; the tabs keep what the player left showing.
	onOpen { hide back_alt ; show back ; hide grpmessage }
	onEsc { close vrbindings_menu ; open vroptions_menu }
	onClose { uiScript vrBindCancel }

// SIDEBAR //

itemDef {
	name solid_box
	style 1
	rect 4 2 178 426
	border 1
	bordersize 1
	bordercolor .5 .5 .5 .5
	backcolor 0 0 .75 .25
	visible 1
	decoration
	}

itemDef {
	name sb_move
	text "Move"
	style 0
	type 1
	textstyle 6
	textscale .4
	rect 0 100 178 40
	textalign ITEM_ALIGN_CENTER
	textalignx 89
	textaligny 28
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; hide grpVB ; show vb_move ; show vb_alt }
	mouseEnter { setitemcolor sb_move forecolor 1 .75 0 1 }
	mouseExit { setitemcolor sb_move forecolor 1 1 1 1 }
	}

itemDef {
	name sb_actions
	text "Shoot"
	style 0
	type 1
	textstyle 6
	textscale .4
	rect 0 150 178 40
	textalign ITEM_ALIGN_CENTER
	textalignx 89
	textaligny 28
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; hide grpVB ; show vb_actions ; show vb_alt }
	mouseEnter { setitemcolor sb_actions forecolor 1 .75 0 1 }
	mouseExit { setitemcolor sb_actions forecolor 1 1 1 1 }
	}

itemDef {
	name sb_follow
	text "Watch"
	style 0
	type 1
	textstyle 6
	textscale .4
	rect 0 200 178 40
	textalign ITEM_ALIGN_CENTER
	textalignx 89
	textaligny 28
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; hide grpVB ; show vb_follow ; show vb_alt }
	mouseEnter { setitemcolor sb_follow forecolor 1 .75 0 1 }
	mouseExit { setitemcolor sb_follow forecolor 1 1 1 1 }
	}

itemDef {
	name sb_system
	text "Misc"
	style 0
	type 1
	textstyle 6
	textscale .4
	rect 0 250 178 40
	textalign ITEM_ALIGN_CENTER
	textalignx 89
	textaligny 28
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; hide grpVB ; show vb_system ; show vb_alt }
	mouseEnter { setitemcolor sb_system forecolor 1 .75 0 1 }
	mouseExit { setitemcolor sb_system forecolor 1 1 1 1 }
	}

itemDef {
	name sb_reset
	text "Reset All"
	style 0
	type 1
	textstyle 6
	textscale .4
	rect 0 330 178 40
	textalign ITEM_ALIGN_CENTER
	textalignx 89
	textaligny 28
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; open vrbindings_confirm }
	mouseEnter { setitemcolor sb_reset forecolor 1 .75 0 1 }
	mouseExit { setitemcolor sb_reset forecolor 1 1 1 1 }
	}

// CONTENT PANEL //

itemDef {
	name window
	rect 186 2 450 426
	style WINDOW_STYLE_FILLED
	border 1
	bordercolor .5 .5 .5 .5
	backcolor 0 0 0 .25
	visible 1
	decoration
	}

itemDef {
