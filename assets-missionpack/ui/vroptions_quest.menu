#include "ui/menudef.h"

{
\\ VR OPTIONS (QUEST) - self-contained sidebar menu \\

menuDef {
	name "vroptions_menu"
	visible 0
	fullscreen 1
	rect 0 0 640 480
	background "menuback_a"
	focusColor 1 .75 0 1
	style 1
	border 1
	onOpen { setitemcolor fadebox backcolor 0 0 0 1 ;
		fadeout fadebox ;
		hide back_alt ; show back ; hide grpmessage ;
		hide grpVR ; show comfort }
	onEsc { close vroptions_menu ; open setup_menu }

// SIDEBAR //

itemDef {
	name solid_box
	style 1
	rect 4 2 178 426
	border 1
	bordersize 1
	bordercolor .5 .5 .5 .5
	backcolor 0 0 .75 .25
	visible 1
	decoration
	mouseEnter { setcolor backcolor .75 0 0 .5 }
	mouseExit { setcolor backcolor 0 0 .75 .25 }
	}

itemDef {
	name sb_comfort
	text "Comfort"
	style 0
	type 1
	textstyle 6
	textscale .4
	rect 0 100 178 40
	textalign ITEM_ALIGN_CENTER
	textalignx 89
	textaligny 28
	backcolor 0 0 0 0
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; hide grpVR ; show comfort }
	mouseEnter { setitemcolor sb_comfort forecolor 1 .75 0 1 }
	mouseExit { setitemcolor sb_comfort forecolor 1 1 1 1 }
	}

itemDef {
	name sb_controls
	text "Controls"
	style 0
	type 1
	textstyle 6
	textscale .4
	rect 0 150 178 40
	textalign ITEM_ALIGN_CENTER
	textalignx 89
	textaligny 28
	backcolor 0 0 0 0
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; hide grpVR ; show controls }
	mouseEnter { setitemcolor sb_controls forecolor 1 .75 0 1 }
	mouseExit { setitemcolor sb_controls forecolor 1 1 1 1 }
	}

itemDef {
	name sb_hud
	text "HUD & Display"
	style 0
	type 1
	textstyle 6
	textscale .4
	rect 0 200 178 40
	textalign ITEM_ALIGN_CENTER
	textalignx 89
	textaligny 28
	backcolor 0 0 0 0
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; hide grpVR ; show hud }
	mouseEnter { setitemcolor sb_hud forecolor 1 .75 0 1 }
	mouseExit { setitemcolor sb_hud forecolor 1 1 1 1 }
	}

itemDef {
	name sb_console
	text "Console"
	style 0
	type 1
	textstyle 6
	textscale .4
	rect 0 250 178 40
	textalign ITEM_ALIGN_CENTER
	textalignx 89
	textaligny 28
	backcolor 0 0 0 0
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ; exec "toggleconsole" }
	mouseEnter { setitemcolor sb_console forecolor 1 .75 0 1 }
	mouseExit { setitemcolor sb_console forecolor 1 1 1 1 }
	}

// CONTENT PANEL //

itemDef {
	name window
	rect 186 2 450 426
	style WINDOW_STYLE_FILLED
	border 1
	bordercolor .5 .5 .5 .5
	backcolor 0 0 0 .25
	visible 1
	decoration
	}

// COMFORT GROUP //

itemDef {
