		type ITEM_TYPE_MULTI
		text "TVD Download:"
		cvar "cl_tvDownload"
		cvarFloatList { "Off" 0 "Decline" 1 "Accept" 2 }
		rect 245 225 210 20
		textalign ITEM_ALIGN_RIGHT
		textalignx 128
		textaligny 20
		textscale .3
