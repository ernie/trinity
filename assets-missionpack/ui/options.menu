itemDef {
		name msg_blooddensity
		text "Blood density is performance-heavy on standalone headsets"
		rect 0 375 443 20
		textalign ITEM_ALIGN_CENTER
		textalignx 221
		textaligny 14
		textscale .25
		forecolor 1 .75 0 1
		visible 0
		decoration
		cvarTest "ui_vrActive"
		showCvar { "1" }
	}

itemDef {
      	name fadebox
      	style WINDOW_STYLE_FILLED
 	background "ui/assets/fadebox.tga"
	forecolor 0 0 0 1
	backcolor 0 0 0 1
	rect 0 0 640 480
