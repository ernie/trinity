itemDef {
		name options
		group grpOptions
		text "Blood:"
		type ITEM_TYPE_MULTI
		cvar "com_blood"
		cvarFloatList { "Off" 0 "Classic" 1 "Modern" 2 }
		rect 245 265 210 20
		textalign ITEM_ALIGN_RIGHT
		textalignx 128
		textaligny 20
		textscale .3
		forecolor 1 1 1 1
		visible 1
	}

itemDef {
		name options
		group grpOptions
		text "Blood Density:"
		type ITEM_TYPE_MULTI
		cvar "cg_bloodDensity"
		cvarFloatList { "Light" 0 "Medium" 1 "Heavy" 2 }
		rect 245 285 210 20
		textalign ITEM_ALIGN_RIGHT
		textalignx 128
		textaligny 20
		textscale .3
		forecolor 1 1 1 1
		visible 1
		cvarTest "com_blood"
		enableCvar { "2" }
		mouseEnter { show msg_blooddensity }
		mouseExit { hide msg_blooddensity }
	}

itemDef {
		name options
		group grpOptions
		text "Damage Numbers:"
