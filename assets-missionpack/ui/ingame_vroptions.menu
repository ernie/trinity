itemDef {
	name hud
	group grpVR
	type ITEM_TYPE_OWNERDRAW
	text "Foveation Strength:"
	ownerdraw UI_FOVEATION_STRENGTH
	rect 50 302 340 18
	textalign ITEM_ALIGN_RIGHT
	textalignx 180
	textaligny 14
	textscale .25
	forecolor 1 1 1 1
	visible 0
	cvarTest "ui_vrFoveationAvailable"
	showCvar { "1" }
	}
itemDef {
	name hud
	group grpVR
	text "Apply"
	type 1
	textscale .25
	style WINDOW_STYLE_FILLED
	background "ui/assets/button_back.tga"
	rect 181 326 100 20
	textalign 1
	textalignx 50
	textaligny 15
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1
	visible 0
	action { play "sound/misc/kcaction.wav" ; exec "vid_restart" }
	mouseEnter { setcolor backcolor .1 .37 .1 1 }
	mouseExit { setcolor backcolor .37 .1 .1 1 }
	}

// DESKTOP MIRROR GROUP (PC ONLY)	//

itemDef {
	name mirror
	group grpVR
	type ITEM_TYPE_MULTI
	text "Mode:"
	cvar "ui_vrDesktopMode"
	cvarFloatList { "Off" 0 "Windowed" 1 "Fullscreen" 2 }
	rect 50 50 340 18
	textalign ITEM_ALIGN_RIGHT
	textalignx 180
	textaligny 14
	textscale .25
	forecolor 1 1 1 1
	visible 0
	}
itemDef {
	name mirror
	group grpVR
	text "Window Resolution:"
	rect 50 68 180 18
	textalign ITEM_ALIGN_RIGHT
	textalignx 180
	textaligny 14
	textscale .25
	forecolor 1 1 1 1
	visible 0
	decoration
	}
itemDef {
	name mirror
	group grpVR
	type ITEM_TYPE_TEXT
	cvar "ui_vrDesktopResLabel"
	rect 235 68 170 18
	textalign ITEM_ALIGN_LEFT
	textalignx 0
	textaligny 14
	textscale .25
	forecolor 1 1 1 1
	visible 0
	cvarTest "ui_vrDesktopMode"
	enableCvar { "1" }
	action { uiScript vrMirrorNextRes }
	}
itemDef {
	name mirror
	group grpVR
	type ITEM_TYPE_MULTI
	text "Content type:"
	cvar "vr_desktopContentType"
	cvarFloatList { "Left eye" 0 "Right eye" 1 "Both eyes" 2 }
	rect 50 86 340 18
	textalign ITEM_ALIGN_RIGHT
	textalignx 180
	textaligny 14
	textscale .25
	forecolor 1 1 1 1
	visible 0
	}
itemDef {
	name mirror
	group grpVR
	type ITEM_TYPE_MULTI
	text "Content fit:"
	cvar "vr_desktopContentFit"
	cvarFloatList { "Fit / Contain" 0 "Fill / Crop" 1 }
	rect 50 104 340 18
	textalign ITEM_ALIGN_RIGHT
	textalignx 180
	textaligny 14
	textscale .25
	forecolor 1 1 1 1
	visible 0
	}
itemDef {
	name mirror
	group grpVR
	type ITEM_TYPE_MULTI
	text "Menu style:"
	cvar "vr_desktopMenuStyle"
	cvarFloatList { "Desktop view" 0 "VR view" 1 }
	rect 50 122 340 18
	textalign ITEM_ALIGN_RIGHT
	textalignx 180
	textaligny 14
	textscale .25
	forecolor 1 1 1 1
	visible 0
	}
itemDef {
	name mirror
	group grpVR
	text "Apply"
	type 1
	textscale .25
	style WINDOW_STYLE_FILLED
	background "ui/assets/button_back.tga"
	rect 181 155 100 20
	textalign 1
	textalignx 50
	textaligny 15
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1
	visible 0
	action { play "sound/misc/kcaction.wav" ; uiScript vrMirrorApply }
	mouseEnter { setcolor backcolor .1 .37 .1 1 }
	mouseExit { setcolor backcolor .37 .1 .1 1 }
	}

}

}
