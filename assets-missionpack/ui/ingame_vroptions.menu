// TAB BUTTONS	//

itemDef {
	name tab_comfort
	group grpTabButtons
	text "Comfort"
	type 1
	textscale .2
	style WINDOW_STYLE_FILLED
	background "ui/assets/button_back.tga"
	rect 48 26 62 20
	textalign 1
	textalignx 31
	textaligny 15
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1
	visible 1
	action { hide grpVR ; show comfort }
	mouseEnter { setitemcolor tab_comfort backcolor .1 .37 .1 1 }
	mouseExit { setitemcolor tab_comfort backcolor .37 .1 .1 1 }
	}
itemDef {
	name tab_controls
	group grpTabButtons
	text "Controls"
	type 1
	textscale .2
	style WINDOW_STYLE_FILLED
	background "ui/assets/button_back.tga"
	rect 119 26 62 20
	textalign 1
	textalignx 31
	textaligny 15
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1
	visible 1
	action { hide grpVR ; show controls }
	mouseEnter { setitemcolor tab_controls backcolor .1 .37 .1 1 }
	mouseExit { setitemcolor tab_controls backcolor .37 .1 .1 1 }
	}
itemDef {
	name tab_hud
	group grpTabButtons
	text "HUD"
	type 1
	textscale .2
	style WINDOW_STYLE_FILLED
	background "ui/assets/button_back.tga"
	rect 190 26 62 20
	textalign 1
	textalignx 31
	textaligny 15
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1
	visible 1
	action { hide grpVR ; show hud }
	mouseEnter { setitemcolor tab_hud backcolor .1 .37 .1 1 }
	mouseExit { setitemcolor tab_hud backcolor .37 .1 .1 1 }
	}
itemDef {
	name tab_mirror
	group grpTabButtons
	text "Mirror"
	type 1
	textscale .2
	style WINDOW_STYLE_FILLED
	background "ui/assets/button_back.tga"
	rect 261 26 62 20
	textalign 1
	textalignx 31
	textaligny 15
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1
	visible 1
	cvarTest "ui_vrMirrorAvailable"
	showCvar { "1" }
	action { hide grpVR ; show mirror ; uiScript vrMirrorSetup }
	mouseEnter { setitemcolor tab_mirror backcolor .1 .37 .1 1 }
	mouseExit { setitemcolor tab_mirror backcolor .37 .1 .1 1 }
	}
itemDef {
	name tab_console
	group grpTabButtons
	text "Console"
	type 1
	textscale .2
	style WINDOW_STYLE_FILLED
	background "ui/assets/button_back.tga"
	rect 332 26 62 20
	textalign 1
	textalignx 31
	textaligny 15
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1
	visible 1
	cvarTest "ui_vrMirrorAvailable"
	showCvar { "1" }
	action { exec "toggleconsole" }
	mouseEnter { setitemcolor tab_console backcolor .1 .37 .1 1 }
	mouseExit { setitemcolor tab_console backcolor .37 .1 .1 1 }
	}
// takes the Mirror slot where there is no mirror
itemDef {
	name tab_console
	group grpTabButtons
	text "Console"
	type 1
	textscale .2
	style WINDOW_STYLE_FILLED
	background "ui/assets/button_back.tga"
	rect 261 26 62 20
	textalign 1
	textalignx 31
	textaligny 15
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1
	visible 1
	cvarTest "ui_vrMirrorAvailable"
	hideCvar { "1" }
	action { exec "toggleconsole" }
	mouseEnter { setitemcolor tab_console backcolor .1 .37 .1 1 }
	mouseExit { setitemcolor tab_console backcolor .37 .1 .1 1 }
	}

// COMFORT GROUP	//

itemDef {
	name comfort
	group grpVR
